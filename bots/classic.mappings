FIELD com/mojang/minecraft/level/Level random Ljava/util/Random; random
FIELD com/mojang/minecraft/level/Level creativeMode Z creativeMode
FIELD com/mojang/minecraft/level/BlockMap all Ljava/util/List; all
METHOD com/mojang/minecraft/level/Level getTile (III)I getBlock
METHOD com/mojang/minecraft/level/Level setTile (IIII)Z setTile
# only ids Classic has a block for (a crafted chest or door would put a block Classic can't draw)
STUB net/minecraft/world/World setBlock (IIII)Z
METHOD com/mojang/minecraft/level/Level addEntity (Lcom/mojang/minecraft/Entity;)V spawnEntity
METHOD com/mojang/minecraft/level/Level removeEntity (Lcom/mojang/minecraft/Entity;)V despawnEntity
METHOD com/mojang/minecraft/level/Level playSound (Ljava/lang/String;FFFFF)V playSoundf
METHOD com/mojang/minecraft/level/Level clip (Lcom/mojang/minecraft/a/c;Lcom/mojang/minecraft/a/c;)Lcom/mojang/minecraft/g; rayTrace
METHOD com/mojang/minecraft/level/Level getPlayer ()Lcom/mojang/minecraft/Entity; getPlayer
METHOD com/mojang/minecraft/level/Level findEntities (Lcom/mojang/minecraft/Entity;Lcom/mojang/minecraft/phys/AABB;)Ljava/util/List; findEntities
STUB net/minecraft/world/World playSound (Lnet/minecraft/entity/Entity;Ljava/lang/String;FF)V
STUB net/minecraft/world/World entities Ljava/util/List;
STUB net/minecraft/world/World players Ljava/util/List;
STUB net/minecraft/world/World isMultiplayer Z
STUB net/minecraft/world/World ticks J
STUB net/minecraft/world/World time J
STUB net/minecraft/world/World difficulty I
STUB net/minecraft/world/World getData (III)B
STUB net/minecraft/world/World getBlockMetadata (III)I
STUB net/minecraft/world/World setBlockWithMetadata (IIIII)Z
STUB net/minecraft/world/World getEntitiesOfType (Ljava/lang/Class;Lnet/minecraft/util/math/Box;)Ljava/util/List;
STUB net/minecraft/world/World getHeight (II)I
STUB net/minecraft/world/World isChunkLoaded (III)Z
STUB net/minecraft/world/World addEntity (Lnet/minecraft/entity/Entity;)Z
STUB net/minecraft/world/World playSound (DDDLjava/lang/String;FF)V
STUB net/minecraft/world/World setTime (J)V
STUB net/minecraft/world/World getBlockEntity (III)Lnet/minecraft/block/entity/BlockEntity;

