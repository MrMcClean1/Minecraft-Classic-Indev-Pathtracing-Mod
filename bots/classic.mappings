# ------------------------------------------------------------------ world (one array, no chunks, one player)
FIELD com/mojang/minecraft/level/Level width I sizeX
FIELD com/mojang/minecraft/level/Level height I sizeZ
FIELD com/mojang/minecraft/level/Level depth I sizeY
FIELD com/mojang/minecraft/level/Level blockMap Lcom/mojang/minecraft/level/BlockMap; entityMap
