# Classic 0.30 survival (c0.30-s-1858) -> Alpha 1.1.2_01 Feather names, for the Classic Bots (see tools/Remap.java).
# Only what the bots use. Found with javap against the game jar. Classic is further from Alpha than Indev: no item
# stacks, NBT, block entities, materials or tools, so those are SHIM classes (bots/classic/shim, the bots' own),
# and what the game keeps another way is a STUB, filled in by bots/classic/.../Compat.java.

# ------------------------------------------------------------------ classes
CLASS a/a                                       net/minecraft/util/math/MathHelper
CLASS com/mojang/minecraft/level/Level          net/minecraft/world/World
CLASS com/mojang/minecraft/level/BlockMap       net/minecraft/world/EntityMap
CLASS com/mojang/minecraft/level/tile/a         net/minecraft/block/Block
CLASS com/mojang/minecraft/phys/AABB            net/minecraft/util/math/Box
CLASS com/mojang/minecraft/a/c                  net/minecraft/util/math/Vec3d
CLASS com/mojang/minecraft/g                    net/minecraft/util/hit/HitResult
CLASS com/mojang/minecraft/Entity               net/minecraft/entity/Entity
CLASS com/mojang/minecraft/mob/Mob              net/minecraft/entity/mob/MobEntity
CLASS com/mojang/minecraft/player/Player        net/minecraft/entity/mob/player/PlayerEntity
CLASS com/mojang/minecraft/player/Inventory     net/minecraft/entity/mob/player/PlayerInventory
CLASS com/mojang/minecraft/item/Item            net/minecraft/entity/ItemEntity
CLASS com/mojang/minecraft/mob/Zombie           net/minecraft/entity/mob/monster/ZombieEntity
CLASS com/mojang/minecraft/mob/Spider           net/minecraft/entity/mob/monster/SpiderEntity
CLASS com/mojang/minecraft/mob/Skeleton         net/minecraft/entity/mob/monster/SkeletonEntity
CLASS com/mojang/minecraft/mob/Creeper          net/minecraft/entity/mob/monster/CreeperEntity
CLASS com/mojang/minecraft/mob/Sheep            net/minecraft/entity/mob/animal/SheepEntity
CLASS com/mojang/minecraft/mob/Pig              net/minecraft/entity/mob/animal/PigEntity
CLASS com/mojang/minecraft/mob/ai/BasicAI       net/minecraft/entity/ai/BasicAI
CLASS com/mojang/minecraft/l                    net/minecraft/client/Minecraft
# no class for "a monster" in Classic: Compat.isMonster says (zombies, skeletons, creepers, spiders)
TEST net/minecraft/entity/mob/monster/Monster net/minecraft/entity/mob/MobEntity
ABSENT net/minecraft/entity/mob/animal/ChickenEntity net/minecraft/entity/mob/MobEntity
ABSENT net/minecraft/entity/mob/animal/CowEntity net/minecraft/entity/mob/MobEntity
ABSENT net/minecraft/entity/mob/monster/SlimeEntity net/minecraft/entity/mob/MobEntity
# the bots' own stand-ins (never in a Classic level)
SHIM net/minecraft/item/ItemStack
SHIM net/minecraft/item/Item
SHIM net/minecraft/item/FoodItem
SHIM net/minecraft/inventory/Inventory
SHIM net/minecraft/block/entity/BlockEntity
SHIM net/minecraft/block/material/Material
SHIM net/minecraft/nbt/NbtElement
SHIM net/minecraft/nbt/NbtCompound
SHIM net/minecraft/nbt/NbtList

# ------------------------------------------------------------------ util
METHOD a/a a (F)F sin
METHOD a/a b (F)F cos
METHOD a/a c (F)F sqrt
STUB net/minecraft/util/math/MathHelper floor (D)I static
STUB net/minecraft/util/math/MathHelper floor (F)I static
STUB net/minecraft/util/math/Box minX D
STUB net/minecraft/util/math/Box minY D
STUB net/minecraft/util/math/Box minZ D
STUB net/minecraft/util/math/Box maxX D
STUB net/minecraft/util/math/Box maxY D
STUB net/minecraft/util/math/Box maxZ D
STUB net/minecraft/util/math/Box grown (DDD)Lnet/minecraft/util/math/Box;
FIELD com/mojang/minecraft/phys/AABB x0 F minXf
FIELD com/mojang/minecraft/phys/AABB y0 F minYf
FIELD com/mojang/minecraft/phys/AABB z0 F minZf
FIELD com/mojang/minecraft/phys/AABB x1 F maxXf
FIELD com/mojang/minecraft/phys/AABB y1 F maxYf
FIELD com/mojang/minecraft/phys/AABB z1 F maxZf

