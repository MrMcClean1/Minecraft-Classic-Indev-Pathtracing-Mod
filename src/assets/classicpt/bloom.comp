#version 430
// Classic PT: quarter-resolution separable HDR bloom for Cinematic mode.
//   uMode 0: Karis-averaged 4-tap downsample + soft-knee bright pass from uLight * uAlbedo (or uSrc HDR when uFromHdr != 0)
//   uMode 1: horizontal 9-tap Gaussian blur
//   uMode 2: vertical 9-tap Gaussian blur
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uSrc;    // uLight (mode 0) or bloom ping-pong (modes 1-2)
layout(binding = 1) uniform sampler2D uAlbedo; // sqrt(albedo) (mode 0, when uFromHdr == 0)
layout(rgba16f, binding = 0) uniform writeonly image2D outBloom;

uniform ivec2 uDstSize;
uniform int uMode;
uniform int uFromHdr;
uniform int uLook;
uniform float uExposure, uBrightness;

vec3 softThreshold(vec3 c) {
    float br = max(c.r, max(c.g, c.b));
    const float thresh = 0.85;
    const float knee = 0.45;
    float soft = clamp(br - thresh + knee, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee + 1e-4);
    float contrib = max(soft, br - thresh) / max(br, 1e-4);
    return min(c * contrib, vec3(6.0));
}

vec3 sampleHdr(vec2 uv) {
    vec3 c = max(textureLod(uSrc, uv, 0.0).rgb, vec3(0.0));
    if (uFromHdr == 0) {
        vec3 alb = textureLod(uAlbedo, uv, 0.0).rgb;
        alb *= alb;
        if (uLook == 0) c = c * 0.8 + 0.35 * dot(c, vec3(0.333)) + 0.08;
        else if (uLook == 2) c = pow(c, vec3(1.15));
        else if (uLook == 3) c = pow(c, vec3(1.08));
        c *= alb;
    }
    return min(c * uExposure * uBrightness, vec3(12.0));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uDstSize.x || px.y >= uDstSize.y) return;
    vec2 inv = 1.0 / vec2(uDstSize);
    vec2 uv = (vec2(px) + 0.5) * inv;

    if (uMode == 0) {
        vec2 o = inv * 0.25;
        vec3 s0 = softThreshold(sampleHdr(uv + vec2(-o.x, -o.y)));
        vec3 s1 = softThreshold(sampleHdr(uv + vec2( o.x, -o.y)));
        vec3 s2 = softThreshold(sampleHdr(uv + vec2(-o.x,  o.y)));
        vec3 s3 = softThreshold(sampleHdr(uv + vec2( o.x,  o.y)));
        float w0 = 1.0 / (1.0 + max(s0.r, max(s0.g, s0.b)));
        float w1 = 1.0 / (1.0 + max(s1.r, max(s1.g, s1.b)));
        float w2 = 1.0 / (1.0 + max(s2.r, max(s2.g, s2.b)));
        float w3 = 1.0 / (1.0 + max(s3.r, max(s3.g, s3.b)));
        vec3 col = (s0 * w0 + s1 * w1 + s2 * w2 + s3 * w3) / max(w0 + w1 + w2 + w3, 1e-4);
        imageStore(outBloom, px, vec4(col, 1.0));
        return;
    }

    vec2 dir = uMode == 1 ? vec2(inv.x, 0.0) : vec2(0.0, inv.y);
    const float w[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
    vec3 sum = textureLod(uSrc, uv, 0.0).rgb * w[0];
    for (int i = 1; i < 5; i++) {
        vec2 off = dir * float(i) * 1.45;
        sum += (textureLod(uSrc, uv + off, 0.0).rgb + textureLod(uSrc, uv - off, 0.0).rgb) * w[i];
    }
    imageStore(outBloom, px, vec4(sum, 1.0));
}
