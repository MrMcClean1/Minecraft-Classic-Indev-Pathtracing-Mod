#version 430
// Classic PT, after DLSS Ray Reconstruction: its denoised, window-sized HDR picture exposed and tone mapped as
// compose.comp does it (the Look and the texture colour are already in, rr_prep.comp).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uHdr;
layout(binding = 1) uniform sampler2D uBloom;
layout(rgba8, binding = 0) uniform writeonly image2D outImage;

uniform ivec2 uRes;
uniform float uExposure, uBrightness;
uniform int uCinematic;

vec3 aces(vec3 x) { return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0); }

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uRes.x || px.y >= uRes.y) return;
    vec3 c = max(texelFetch(uHdr, px, 0).rgb, vec3(0.0)) * uExposure * uBrightness;
    if (uCinematic != 0) {
        vec2 uv = (vec2(px) + 0.5) / vec2(uRes);
        c += max(textureLod(uBloom, uv, 0.0).rgb, vec3(0.0)) * 0.24;
        c = aces(c * 0.92);
        float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
        c = clamp(mix(vec3(l), c, 1.08), 0.0, 1.0);
        vec2 q = uv * 2.0 - 1.0;
        c *= 1.0 - 0.09 * dot(q, q);
        imageStore(outImage, px, vec4(pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2)), 1.0));
        return;
    }
    imageStore(outImage, px, vec4(pow(aces(c), vec3(1.0 / 2.2)), 1.0));
}
