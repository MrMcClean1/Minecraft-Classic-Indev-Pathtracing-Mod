#version 430
// Classic PT, pass 1 of 4: the path tracer. Classic and Indev keep the whole level in one array, so it is one 3D
// texture. Per pixel: a camera ray through the block grid, sunlight (with cloud shadows) and its shadow ray, one
// light from a nearby torch, lava or fire (or the torch in your hand), diffuse bounces that end in the sky, water
// that reflects and refracts (with waves). It writes this frame's noisy light with the texture colour taken out,
// that colour, and the surface (normal, distance) for the denoiser (temporal.comp, atrous.comp, compose.comp).
// Shared with the Alpha/Beta tracers (pt_base.glsl): the random numbers, light colours, Fresnel term, waving
// plants and water waves. Keep them in step.
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image2D outLight;   // light without the texture colour (noisy)
layout(rgba8, binding = 1) uniform writeonly image2D outAlbedo;    // the texture colour it was divided by
layout(rgba16f, binding = 2) uniform writeonly image2D outGeom;    // normal, distance (-1 for sky)
layout(binding = 0) uniform usampler3D uWorld;    // block id, texel (x, z, y)
layout(binding = 1) uniform sampler2D uAtlas;     // the game's terrain.png
layout(binding = 2) uniform sampler2D uClouds;    // the game's clouds.png
layout(std430, binding = 2) readonly buffer Info { uint info[]; };    // 8 per id: shape, 6 face tiles, spare
layout(std430, binding = 3) readonly buffer Lights { vec4 lights[]; }; // block centre, w = id

uniform ivec3 uSize;              // x, y (height), z
uniform vec3 uCam, uFwd, uRight, uUp;
uniform float uTan, uAspect;
uniform ivec2 uRes;
uniform int uFrame, uLightCount, uSamples, uBounces, uView, uEffects, uReflect;
uniform vec3 uSunDir, uSunColor, uSkyTop, uSkyHorizon, uFogColor;
uniform float uWaterY, uGroundY;  // around the map: the water's surface and the ground under it
uniform float uTime, uCloudY, uCloudShadow, uFogEnd;
uniform vec4 uHeld;               // held light: position, strength (0 = none)
uniform vec2 uJitter;             // DLSS: this frame's sub-pixel nudge, pixels (0 otherwise)
uniform int uPointSample;         // DLSS: every sample through the jittered point (it adds frames up itself)
uniform vec2 uDof;                // photo mode: lens radius and focus distance in blocks (radius 0: no depth of field)
uniform float uMaxDist;           // traceDistance: how far camera rays look (blocks)
// the sky the camera sees, as the game draws it (Tracer.readGameFog): its colours (display values 0..1), the linear fog
// it set up this frame, its sky plane's height; and compose.comp's tone curve, run backwards to land on those colours
uniform vec3 uGameSky, uGameFog, uGameCloud;
uniform vec2 uGameFogRange;       // fog start, end (blocks)
uniform float uSkyPlaneY, uExposure, uBrightness;
uniform int uLook;                // compose.comp's Look: 0 Beta, 1 Traced, 2 Realistic
bool primaryWater;                // the camera ray's first surface was water (Ray Reconstruction's guides)

const uint AIR = 0u, CUBE = 1u, CUTOUT = 2u, CROSS = 3u, WATER = 4u, LAVA = 5u, SLAB = 6u, TORCH = 7u, LOW = 8u;
const uint EXIT = 65535u;         // leaving water (underwater rays)
const int M_VIEW = 0, M_SHADOW = 1, M_UNDERWATER = 2;
const int FX_SPARKLE = 4, FX_GODRAYS = 8, FX_WAVING = 16, FX_WAVES = 32, FX_CLOUDS = 64, FX_FASTLEAVES = 128; // the same bits as the Alpha/Beta tracers (FASTLEAVES: here only)
const int VIEW_PATH = 0, VIEW_ALBEDO = 1, VIEW_NORMALS = 2, VIEW_LIGHT = 3;
bool fxOn(int bit) { return (uEffects & bit) != 0; }

uint rngState;
uint pcg(uint v) { uint s = v * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
float rnd() { rngState = pcg(rngState); return float(rngState) * (1.0 / 4294967296.0); }

uint blockAt(ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, uSize))) return 0u;
    return texelFetch(uWorld, ivec3(c.x, c.z, c.y), 0).r;
}
uint shapeOf(uint id) { return info[id * 8u]; }
bool isWater(uint id) { return shapeOf(id) == WATER; }

vec4 tileTex(uint tile, vec2 uv) {
    ivec2 ts = textureSize(uAtlas, 0) / 16;
    ivec2 p = ivec2(int(tile % 16u) * ts.x, int(tile / 16u) * ts.y) + clamp(ivec2(floor(uv * vec2(ts))), ivec2(0), ts - 1);
    vec4 c = texelFetch(uAtlas, p, 0);
    return vec4(pow(c.rgb, vec3(2.2)), c.a);
}

// ---------------------------------------------------------------- effects (from pt_base.glsl)
bool sways(uint id) { return id == 18u || id == 37u || id == 38u || id == 6u || id == 59u; }
vec2 swayUV(uint id, ivec3 cell, float height) {
    if (!fxOn(FX_WAVING) || !sways(id)) return vec2(0.0);
    float ph = float(cell.x) * 0.71 + float(cell.z) * 0.93 + float(cell.y) * 0.37;
    float s = sin(uTime * 1.6 + ph) * 0.65 + sin(uTime * 2.7 + ph * 1.9) * 0.35;
    float amp = 0.6 * (id == 18u ? 0.03 : 0.07 * clamp(height, 0.0, 1.0));
    return vec2(s * amp, id == 18u ? cos(uTime * 1.2 + ph) * amp * 0.6 : 0.0);
}
vec3 waveNormal(vec2 xz) {
    vec2 g = vec2(0.0);
    const vec2 D0 = vec2(0.8, 0.6), D1 = vec2(-0.5, 0.86), D2 = vec2(0.2, -0.98);
    g += D0 * 0.045 * cos(dot(D0, xz) * 1.9 + uTime * 1.5);
    g += D1 * 0.035 * cos(dot(D1, xz) * 3.1 + uTime * 2.2);
    g += D2 * 0.020 * cos(dot(D2, xz) * 5.3 + uTime * 3.1);
    g *= 0.7;
    return normalize(vec3(-g.x, 1.0, -g.y));
}

vec3 faceNormal(int f) {
    return f == 0 ? vec3(0, -1, 0) : f == 1 ? vec3(0, 1, 0) : f == 2 ? vec3(0, 0, -1) : f == 3 ? vec3(0, 0, 1) : f == 4 ? vec3(-1, 0, 0) : vec3(1, 0, 0);
}
// Minecraft's face texture layout: tops by x/z, sides with v going down
vec2 faceUV(int f, vec3 p) {
    if (f <= 1) return p.xz;
    if (f == 2) return vec2(1.0 - p.x, 1.0 - p.y);
    if (f == 3) return vec2(p.x, 1.0 - p.y);
    if (f == 4) return vec2(p.z, 1.0 - p.y);
    return vec2(1.0 - p.z, 1.0 - p.y);
}

// Light given off, the same units as the Alpha/Beta tracers (sun = 3). The texture colour is applied by the caller.
vec3 emission(uint id) {
    if (id == 50u) return vec3(1.0, 0.76, 0.50) * 6.0;               // torch
    if (id == 51u) return vec3(1.0, 0.62, 0.30) * 6.0;               // fire
    if (shapeOf(id) == LAVA) return vec3(1.0, 0.45, 0.12) * 5.0;     // lava (and Indev's infinite lava source)
    return vec3(0.0);
}
float fresnel(float f0, float cosT) { return f0 + (1.0 - f0) * pow(1.0 - clamp(cosT, 0.0, 1.0), 5.0); }

struct Hit { float t; vec3 n; uint id; vec4 col; };

bool boxHit(vec3 o, vec3 rd, vec3 lo, vec3 hi, float tMin, float tMax, out float t, out int face) {
    vec3 inv = 1.0 / rd;
    vec3 t0 = (lo - o) * inv, t1 = (hi - o) * inv;
    vec3 tn = min(t0, t1), tf = max(t0, t1);
    float a = max(max(tn.x, tn.y), tn.z), b = min(min(tf.x, tf.y), tf.z);
    if (a > b || a < tMin || a > tMax) return false;
    t = a;
    face = a == tn.x ? (rd.x > 0.0 ? 4 : 5) : a == tn.y ? (rd.y > 0.0 ? 0 : 1) : (rd.z > 0.0 ? 2 : 3);
    return true;
}

bool voxel(ivec3 c, uint id, vec3 ro, vec3 rd, float tIn, float tOut, int mode, inout Hit h) {
    uint shape = shapeOf(id);
    if (shape == AIR) return false;
    if (shape == WATER && mode != M_VIEW) return false;   // shadows and underwater rays go through water
    vec3 o = ro - vec3(c);
    float tMin = max(tIn - 1e-4, 1e-4);
    if (shape == CROSS) {
        float best = 1e30; vec4 col; vec3 n;
        for (int k = 0; k < 2; k++) {
            vec3 pn = k == 0 ? vec3(0.70710678, 0.0, -0.70710678) : vec3(0.70710678, 0.0, 0.70710678);
            float d = k == 0 ? 0.0 : 0.70710678;
            float den = dot(rd, pn);
            if (abs(den) < 1e-6) continue;
            float t = (d - dot(o, pn)) / den;
            if (t < tMin || t > tOut + 1e-4 || t >= best) continue;
            vec3 p = o + rd * t;
            if (any(lessThan(p, vec3(0.0))) || any(greaterThan(p, vec3(1.0)))) continue;
            vec2 uv = vec2(k == 0 ? p.x : 1.0 - p.x, 1.0 - p.y) - swayUV(id, c, p.y);
            if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) continue;
            vec4 tc = tileTex(info[id * 8u + 3u], uv);
            if (tc.a < 0.1) continue;
            best = t; col = tc; n = den < 0.0 ? pn : -pn;
        }
        if (best > 1e29) return false;
        h.t = best; h.n = normalize(n + vec3(0.0, 0.6, 0.0)); h.id = id; h.col = col;
        return true;
    }
    vec3 lo = vec3(0.0), hi = vec3(1.0);
    if (shape == SLAB) hi.y = 0.5;
    if (shape == LOW) hi.y = 0.9375;
    if (shape == TORCH) { lo = vec3(0.4375, 0.0, 0.4375); hi = vec3(0.5625, 0.625, 0.5625); }
    if (shape == WATER || shape == LAVA) {
        uint above = blockAt(c + ivec3(0, 1, 0));
        hi.y = shapeOf(above) == shape ? 1.0 : 0.875;
    }
    float t; int f;
    if (boxHit(o, rd, lo, hi, tMin, tOut + 1e-3, t, f)) {
        vec3 p = o + rd * t;
        vec2 uv = faceUV(f, p);
        if (id == 18u) uv = fract(uv - swayUV(id, c, 1.0));
        vec4 tc = tileTex(info[id * 8u + 1u + uint(f)], uv);
        // Fast leaves (leaves=fast): solid, the see-through pixels a dark leafy green, as Fast graphics draws them
        if (id == 18u && fxOn(FX_FASTLEAVES)) { if (tc.a < 0.1) tc.rgb = vec3(0.10, 0.16, 0.06); tc.a = 1.0; }
        if (shape == CUTOUT && tc.a < 0.1) {
            // see-through pixel: the far side of the same block
            vec3 inv = 1.0 / rd;
            vec3 t0 = (lo - o) * inv, t1 = (hi - o) * inv, tf = max(t0, t1);
            float b = min(min(tf.x, tf.y), tf.z);
            int fb = b == tf.x ? (rd.x > 0.0 ? 5 : 4) : b == tf.y ? (rd.y > 0.0 ? 1 : 0) : (rd.z > 0.0 ? 3 : 2);
            vec3 q = o + rd * b;
            tc = tileTex(info[id * 8u + 1u + uint(fb)], faceUV(fb, q));
            if (tc.a < 0.1) return false;
            t = b; f = fb;
            h.n = -faceNormal(fb);
        } else {
            if (tc.a < 0.1 && shape != WATER && shape != LAVA) return false;
            h.n = faceNormal(f);
            if (shape == WATER && f == 1 && fxOn(FX_WAVES)) h.n = waveNormal(vec2(c.xz) + p.xz);
        }
        h.t = t; h.id = id; h.col = tc;
        return true;
    }
    return false;
}

// Around the map (Classic's and Indev's edge): a water plane, with ground under it, beyond the map's x/z edges.
bool outside(vec3 ro, vec3 rd, float maxT, int mode, inout Hit h) {
    if (abs(rd.y) < 1e-5) return false;
    for (int k = 0; k < 2; k++) {
        float y = k == 0 ? uWaterY : uGroundY;
        if (k == 0 && (mode != M_VIEW || uWaterY <= uGroundY)) continue;
        float t = (y - ro.y) / rd.y;
        if (t <= 1e-4 || t > maxT) continue;
        vec3 p = ro + rd * t;
        if (p.x >= 0.0 && p.z >= 0.0 && p.x <= float(uSize.x) && p.z <= float(uSize.z)) continue;
        uint id = k == 0 ? 9u : 7u;
        h.t = t; h.n = vec3(0.0, rd.y < 0.0 ? 1.0 : -1.0, 0.0); h.id = id;
        if (k == 0 && fxOn(FX_WAVES)) h.n = waveNormal(p.xz);
        h.col = tileTex(info[id * 8u + 2u], fract(p.xz));
        return true;
    }
    return false;
}

bool trace(vec3 ro, vec3 rd, float maxT, int mode, out Hit h) {
    h.t = 1e30; h.id = 0u;
    vec3 inv = 1.0 / rd;
    vec3 t0 = (vec3(0.0) - ro) * inv, t1 = (vec3(uSize) - ro) * inv;
    vec3 tn = min(t0, t1), tf = max(t0, t1);
    float tA = max(max(tn.x, tn.y), tn.z), tB = min(min(tf.x, tf.y), tf.z);
    if (tA <= tB && tB > 0.0) {
        float t = max(tA, 0.0);
        ivec3 c = clamp(ivec3(floor(ro + rd * (t + 1e-4))), ivec3(0), uSize - 1);
        ivec3 st = ivec3(sign(rd));
        vec3 tDelta = abs(inv);
        vec3 tMax = (vec3(c) + max(vec3(st), vec3(0.0)) - ro) * inv;
        bool wasWater = mode == M_UNDERWATER;
        for (int i = 0; i < 1024; i++) {
            if (t > maxT) return false;
            uint id = blockAt(c);
            float tNext = min(min(tMax.x, tMax.y), tMax.z);
            if (mode == M_UNDERWATER) {
                bool w = isWater(id);
                if (wasWater && !w && shapeOf(id) != CUTOUT && shapeOf(id) != CUBE && shapeOf(id) != LAVA) {
                    h.t = t; h.n = vec3(0.0, 1.0, 0.0); h.id = EXIT; // the ray just carries on in air
                    return true;
                }
                wasWater = w;
            }
            if (id != 0u && voxel(c, id, ro, rd, t, tNext, mode, h)) return h.t <= maxT;
            if (tMax.x < tMax.y && tMax.x < tMax.z) { c.x += st.x; t = tMax.x; tMax.x += tDelta.x; }
            else if (tMax.y < tMax.z) { c.y += st.y; t = tMax.y; tMax.y += tDelta.y; }
            else { c.z += st.z; t = tMax.z; tMax.z += tDelta.z; }
            if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, uSize))) break;
        }
    }
    return outside(ro, rd, maxT, mode, h);
}

// ---------------------------------------------------------------- sky, clouds, fog
float cloudAt(vec2 xz) {
    vec2 uv = (xz + vec2(uTime * 0.6, 0.0)) / 2048.0; // as the game: clouds.png over 2048 blocks, 0.6 blocks a second
    return texture(uClouds, uv).a; // clouds.png is white; the shape is in its alpha
}
vec3 sky(vec3 d) {
    vec3 c = mix(uSkyHorizon, uSkyTop, pow(clamp(d.y, 0.0, 1.0), 0.6));
    if (d.y < 0.0) c = uSkyHorizon * 0.8;
    return c;
}
// compose.comp backwards (the Look, exposure and brightness, ACES, gamma): the light that comes out as display colour s
vec3 displayToLight(vec3 s) {
    vec3 y = pow(clamp(s, vec3(0.0), vec3(0.995)), vec3(2.2));
    // ACES: y = x(2.51x + 0.03) / (x(2.43x + 0.59) + 0.14), solved for x
    vec3 a = 2.43 * y - 2.51, b = 0.59 * y - 0.03, c = 0.14 * y;
    vec3 x = (-b - sqrt(max(b * b - 4.0 * a * c, vec3(0.0)))) / (2.0 * a);
    x = max(x, vec3(0.0)) / max(uExposure * uBrightness, 1e-3);
    if (uLook == 0) { // c * 0.8 + 0.35 * dot(c, 0.333) + 0.08
        float m = (dot(x, vec3(1.0 / 3.0)) - 0.08) / (0.8 + 0.35 * 0.999);
        x = (x - 0.35 * 0.999 * m - 0.08) / 0.8;
    } else if (uLook == 2) x = pow(x, vec3(1.0 / 1.15));
    return max(x, vec3(0.0));
}
float gameFog(float t) { return clamp((t - uGameFogRange.x) / max(uGameFogRange.y - uGameFogRange.x, 1.0), 0.0, 1.0); }

// What a camera ray sees of the sky: the game's own sky plane, clouds and fog, in the game's colours (not the sky that
// lights the world, sky() above), plus the sun's disc.
vec3 skyView(vec3 ro, vec3 d) {
    vec3 col = uGameFog;   // under the horizon and past the sky plane: the game's fog (its clear colour)
    if (d.y > 1e-4 && ro.y < uSkyPlaneY) col = mix(uGameSky, uGameFog, gameFog((uSkyPlaneY - ro.y) / d.y));
    if (fxOn(FX_CLOUDS) && d.y > 1e-4 && ro.y < uCloudY) {
        float t = (uCloudY - ro.y) / d.y;
        col = mix(col, mix(uGameCloud, uGameFog, gameFog(t)), cloudAt((ro + d * t).xz));
    }
    return displayToLight(col) + uSunColor * 6.0 * smoothstep(0.9990, 0.9996, dot(d, uSunDir));
}
float cloudShade(vec3 p) {
    if (!fxOn(FX_CLOUDS) || uCloudShadow <= 0.0 || uSunDir.y <= 0.05) return 1.0;
    float t = (uCloudY - p.y) / uSunDir.y;
    return 1.0 - uCloudShadow * cloudAt((p + uSunDir * t).xz);
}

vec3 cosineDir(vec3 n) {
    float a = rnd() * 6.2831853, r = sqrt(rnd());
    vec3 t = normalize(abs(n.y) < 0.9 ? cross(n, vec3(0, 1, 0)) : cross(n, vec3(1, 0, 0)));
    vec3 b = cross(n, t);
    return normalize(t * (r * cos(a)) + b * (r * sin(a)) + n * sqrt(max(0.0, 1.0 - r * r)));
}

vec3 blockLight(vec3 p, vec3 n) {
    vec3 L = vec3(0.0);
    if (uLightCount > 0) {
        int k = min(int(rnd() * float(uLightCount)), uLightCount - 1);
        vec4 l = lights[k];
        vec3 lp = l.xyz + (vec3(rnd(), rnd(), rnd()) - 0.5) * 0.6;
        vec3 d = lp - p;
        float dist = length(d);
        d /= dist;
        float c = dot(n, d);
        Hit s;
        if (c > 0.0 && dist < 24.0 && !trace(p + n * 1e-3, d, dist - 0.55, M_SHADOW, s))
            L += emission(uint(l.w)) * c * float(uLightCount) * 0.35 / (1.0 + dist * dist);
    }
    if (uHeld.w > 0.0) { // the torch in your hand
        vec3 d = uHeld.xyz - p;
        float dist = length(d);
        d /= dist;
        float c = dot(n, d);
        Hit s;
        if (c > 0.0 && dist < 16.0 && !trace(p + n * 1e-3, d, dist - 0.3, M_SHADOW, s))
            L += vec3(1.0, 0.76, 0.50) * 6.0 * uHeld.w * c * 0.35 / (1.0 + dist * dist);
    }
    return L;
}

// One path. Returns the light; albedo/normal/dist describe what the camera sees first, for the denoiser.
vec3 radiance(vec3 ro, vec3 rd, out vec3 albedo, out vec3 normal, out float dist) {
    vec3 L = vec3(0.0), T = vec3(1.0);
    albedo = vec3(1.0); normal = vec3(0.0); dist = -1.0;
    bool primary = true;   // still looking for the first surface (the one the texture colour is taken out of)
    int mode = isWater(blockAt(ivec3(floor(ro)))) ? M_UNDERWATER : M_VIEW;
    int bounces = 0;
    float travelled = 0.0;
    for (int step = 0; step < 8 && bounces <= uBounces; step++) {
        Hit h;
        if (!trace(ro, rd, bounces == 0 ? uMaxDist : 600.0, mode, h)) {
            L += T * (bounces == 0 ? skyView(ro, rd) : sky(rd));
            break;
        }
        vec3 p = ro + rd * h.t;
        if (bounces == 0) travelled += h.t;
        if (mode == M_UNDERWATER) T *= exp(-h.t * vec3(0.30, 0.09, 0.06));
        if (h.id == EXIT) { mode = M_VIEW; ro = p + rd * 1e-3; continue; }
        if (mode == M_VIEW && isWater(h.id)) {
            if (primary) { normal = h.n; dist = travelled; primary = false; primaryWater = true; } // water: no texture to take out
            float F = uReflect == 0 ? 0.0 : fresnel(0.02, dot(-rd, h.n));
            if (rnd() < F) { rd = reflect(rd, h.n); ro = p + h.n * 1e-3; }
            else { mode = M_UNDERWATER; ro = p - h.n * 1e-3; rd = refract(rd, h.n, 1.0 / 1.33); if (dot(rd, rd) < 0.5) rd = reflect(rd, h.n); T *= h.col.rgb * 1.6; }
            continue;
        }
        vec3 alb = h.col.rgb;
        if (primary) {
            primary = false;
            // the light is stored without this surface's colour (compose.comp multiplies it back), so the
            // throughput from here on leaves it out: what is in T so far (underwater tint) goes into the albedo
            albedo = T * alb; normal = h.n; dist = travelled;
            T = vec3(1.0);
            vec3 e = emission(h.id);
            if (e.x > 0.0) { L += e; if (shapeOf(h.id) == LAVA) break; }
        } else {
            vec3 e = emission(h.id);
            if (e.x > 0.0) { L += T * e * alb; if (shapeOf(h.id) == LAVA) break; }
            T *= alb;
        }
        float nd = dot(h.n, uSunDir);
        if (nd > 0.0) {
            Hit s;
            if (!trace(p + h.n * 1e-3, uSunDir, 600.0, M_SHADOW, s)) {
                L += T * uSunColor * nd * cloudShade(p);
                // snow sparkle (fx.snowSparkle): a few texels of snow and ice, each its own slightly tilted mirror
                if (bounces == 0 && fxOn(FX_SPARKLE) && (h.id == 78u || h.id == 79u || h.id == 80u) && h.n.y > 0.5) {
                    ivec3 sc = ivec3(floor(p * 16.0));
                    uint hs = pcg(uint(sc.x) * 73856093u ^ uint(sc.y) * 19349663u ^ uint(sc.z) * 83492791u);
                    if ((hs & 255u) < 16u) {
                        vec3 jn = normalize(h.n + vec3(float((hs >> 8) & 255u) / 127.5 - 1.0, 0.0, float((hs >> 16) & 255u) / 127.5 - 1.0) * 0.45);
                        L += T * uSunColor * pow(max(dot(reflect(rd, jn), uSunDir), 0.0), 150.0) * 4.0;
                    }
                }
            }
        }
        L += T * blockLight(p, h.n);
        rd = cosineDir(h.n);
        ro = p + h.n * 1e-3;
        bounces++;
    }
    if (dist > 0.0 && uFogEnd > 0.0) { // Classic's linear fog, on the whole picture (compose multiplies the albedo back)
        float f = clamp((dist - uFogEnd * 0.25) / (uFogEnd * 0.75), 0.0, 1.0);
        L = mix(L, uFogColor / max(albedo, vec3(0.02)), f);
    }
    return min(L, vec3(48.0));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uRes.x || px.y >= uRes.y) return;
    rngState = pcg(uint(px.x) * 1973u + uint(px.y) * 9277u + uint(uFrame) * 26699u);
    vec3 c = vec3(0.0), alb = vec3(1.0), n = vec3(0.0);
    float dist = -1.0;
    bool water = false;
    for (int s = 0; s < uSamples; s++) {
        // the first sample through the pixel centre keeps the surface data steady for the denoiser
        vec2 j = s == 0 || uPointSample != 0 ? vec2(0.5) + uJitter : vec2(rnd(), rnd());
        primaryWater = false;
        vec2 uv = (vec2(px) + j) / vec2(uRes) * 2.0 - 1.0;
        vec3 rd = normalize(uFwd + uRight * uv.x * uTan * uAspect + uUp * uv.y * uTan);
        // photo mode's depth of field (a thin lens, as pbrt's): the ray starts somewhere on the lens and passes through
        // this pixel's spot on the plane in focus
        vec3 ro = uCam;
        if (uDof.x > 0.0) {
            vec3 fp = rd * (uDof.y / max(dot(rd, uFwd), 0.05));
            float lr = uDof.x * sqrt(rnd()), la = 6.2831853 * rnd();
            vec3 lo = (cos(la) * uRight + sin(la) * uUp) * lr;
            ro = uCam + lo;
            rd = normalize(fp - lo);
        }
        vec3 a, nn; float d;
        vec3 r = radiance(ro, rd, a, nn, d);
        // god rays (fx.godRays): sunlight scattered toward the camera by the air, from the parts of the camera ray the
        // sun reaches (two jittered points), brightest looking toward the sun, as the other tracers' godRays()
        vec3 godL = vec3(0.0);
        if (fxOn(FX_GODRAYS) && uSunDir.y > 0.02 && !isWater(blockAt(ivec3(floor(ro))))) {
            float gEnd = min(d > 0.0 ? d : 600.0, 40.0), vis = 0.0;
            for (int k = 0; k < 2; k++) {
                Hit gs;
                if (!trace(ro + rd * (gEnd * (float(k) + rnd()) / 2.0), uSunDir, 600.0, M_SHADOW, gs)) vis += 0.5;
            }
            float cs = dot(rd, uSunDir);
            const float g = 0.6;
            float phase = (1.0 - g * g) / (12.5663706 * pow(1.0 + g * g - 2.0 * g * cs, 1.5));
            godL = uSunColor * vis * phase * 0.006 * gEnd;
        }
        // with depth of field the surface seen changes from sample to sample: the colour goes into the light (and is
        // averaged with it), the albedo stays white
        c += uDof.x > 0.0 ? r * a + godL : r + godL / max(a, vec3(0.02)); // god rays aren't lit surfaces: the albedo is taken back out
        if (s == 0) { alb = a; n = nn; dist = d; water = primaryWater; }
    }
    c /= float(uSamples);
    if (uDof.x > 0.0) alb = vec3(1.0);
    if (uView == VIEW_ALBEDO) { c = vec3(1.0); }
    else if (uView == VIEW_NORMALS) { alb = vec3(1.0); c = n * 0.5 + 0.5; c = pow(c, vec3(2.2)); }
    else if (uView == VIEW_LIGHT) { alb = vec3(1.0); }
    imageStore(outLight, px, vec4(c, 1.0));
    imageStore(outAlbedo, px, vec4(sqrt(clamp(alb, 0.0, 1.0)), water ? 0.0 : 1.0)); // stored as sqrt for 8-bit precision; a = 0 water
    imageStore(outGeom, px, vec4(n, dist));
}
